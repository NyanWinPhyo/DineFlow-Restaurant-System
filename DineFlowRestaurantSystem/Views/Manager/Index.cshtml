@model DineFlowRestaurantSystem.ViewModels.ManagerDashboardViewModel

@{
    Layout = "~/Views/Shared/_ManagerLayout.cshtml";
    ViewData["Title"] = "Manager Dashboard";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">Manager Dashboard</h2>
            <p class="text-muted mb-0">Welcome, @ViewBag.Username. Monitor restaurant operations.</p>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-md-4">
            <div class="card dashboard-card">
                <div class="card-body">
                    <h6 class="text-muted">Menu Items</h6>
                    <h2>@Model.TotalMenuItems</h2>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card dashboard-card">
                <div class="card-body">
                    <h6 class="text-muted">Available Items</h6>
                    <h2>@Model.AvailableMenuItems</h2>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card dashboard-card">
                <div class="card-body">
                    <h6 class="text-muted">Categories</h6>
                    <h2>@Model.TotalCategories</h2>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-md-4">
            <div class="card dashboard-card">
                <div class="card-body">
                    <h6 class="text-muted">Pending Orders</h6>
                    <h2>@Model.PendingOrders</h2>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card dashboard-card">
                <div class="card-body">
                    <h6 class="text-muted">Preparing Orders</h6>
                    <h2>@Model.PreparingOrders</h2>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card dashboard-card">
                <div class="card-body">
                    <h6 class="text-muted">Pending Reviews</h6>
                    <h2>@Model.PendingReviews</h2>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-3 mb-3">
        <div class="card manager-card">
            <div class="card-body">
                <h6 class="text-muted">Low Stock Ingredients</h6>
                <h3 class="mb-0">@Model.LowStockIngredientCount</h3>
            </div>
        </div>
    </div>

    <div class="card manager-card mt-4">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Low Stock Alerts</h5>
            <a asp-controller="Manager" asp-action="Ingredients" class="btn btn-sm btn-outline-primary">
                View Ingredients
            </a>
        </div>

        <div class="card-body">
            @if (Model.LowStockIngredients.Count == 0)
            {
                <div class="alert alert-success mb-0">
                    All active ingredients are above reorder level.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Ingredient</th>
                                <th>Current Stock</th>
                                <th>Reorder Level</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var ingredient in Model.LowStockIngredients)
                            {
                                <tr>
                                    <td>@ingredient.IngredientName</td>
                                    <td>@ingredient.CurrentStock.ToString("N2") @ingredient.Unit</td>
                                    <td>@ingredient.ReorderLevel.ToString("N2") @ingredient.Unit</td>
                                    <td>
                                        <span class="badge bg-warning text-dark">Low Stock</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>