@model DineFlowRestaurantSystem.ViewModels.StockAdjustmentViewModel

@{
    Layout = "~/Views/Shared/_ManagerLayout.cshtml";
    ViewData["Title"] = "Adjust Stock";
}

<div class="manager-form-container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">Adjust Stock</h2>
            <p class="text-muted mb-0">
                Record stock corrections or ingredient waste.
            </p>
        </div>

        <a asp-controller="Manager"
           asp-action="Ingredients"
           class="btn btn-outline-secondary">
            Back to Ingredients
        </a>
    </div>

    <div class="card manager-card">
        <div class="card-body">

            <form asp-controller="Manager"
                  asp-action="AdjustStock"
                  method="post">

                <input asp-for="IngredientID" type="hidden" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label class="form-label">Ingredient</label>
                    <input class="form-control"
                           value="@Model.IngredientName"
                           readonly />
                </div>

                <div class="mb-3">
                    <label class="form-label">Current Stock</label>
                    <input class="form-control"
                           value="@Model.CurrentStock.ToString("N2") @Model.Unit"
                           readonly />
                </div>

                <div class="mb-3">
                    <label asp-for="TransactionType"
                           class="form-label"></label>

                    <select asp-for="TransactionType"
                            class="form-select"
                            id="transactionType">
                        <option value="Adjustment">
                            Adjustment
                        </option>
                        <option value="Waste">
                            Waste
                        </option>
                    </select>

                    <span asp-validation-for="TransactionType"
                          class="text-danger"></span>
                </div>

                <div class="mb-3"
                     id="adjustmentDirectionSection">

                    <label asp-for="AdjustmentDirection"
                           class="form-label"></label>

                    <select asp-for="AdjustmentDirection"
                            class="form-select">
                        <option value="Increase">
                            Increase Stock
                        </option>
                        <option value="Decrease">
                            Decrease Stock
                        </option>
                    </select>
                </div>

                <div class="mb-3">
                    <label asp-for="Quantity"
                           class="form-label"></label>

                    <div class="input-group">
                        <input asp-for="Quantity"
                               class="form-control"
                               type="number"
                               step="0.01"
                               min="0.01" />

                        <span class="input-group-text">
                            @Model.Unit
                        </span>
                    </div>

                    <span asp-validation-for="Quantity"
                          class="text-danger"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Reason"
                           class="form-label"></label>

                    <textarea asp-for="Reason"
                              class="form-control"
                              rows="3"
                              placeholder="Example: damaged stock, expired ingredient, stock count correction...">
                    </textarea>

                    <span asp-validation-for="Reason"
                          class="text-danger"></span>
                </div>

                <button type="submit"
                        class="btn btn-primary">
                    Record Transaction
                </button>

                <a asp-controller="Manager"
                   asp-action="Ingredients"
                   class="btn btn-outline-secondary">
                    Cancel
                </a>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        const typeSelect =
            document.getElementById("transactionType");

        const directionSection =
            document.getElementById("adjustmentDirectionSection");

        function updateAdjustmentFields() {
            directionSection.style.display =
                typeSelect.value === "Waste"
                    ? "none"
                    : "block";
        }

        typeSelect.addEventListener(
            "change",
            updateAdjustmentFields);

        updateAdjustmentFields();
    </script>
}