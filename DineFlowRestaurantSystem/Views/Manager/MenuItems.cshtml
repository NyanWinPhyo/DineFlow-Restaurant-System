@model List<DineFlowRestaurantSystem.ViewModels.MenuItemListItemViewModel>

@{
    Layout = "~/Views/Shared/_ManagerLayout.cshtml";
    ViewData["Title"] = "Manager Menu Management";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">Menu Item Management</h2>
            <p class="text-muted mb-0">Welcome, @ViewBag.Username. Manage menu items, pricing, and availability.</p>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
    }

    <div class="card dashboard-card mb-4">
        <div class="card-body">
            <form asp-controller="Manager" asp-action="MenuItems" method="get" class="d-flex gap-2">
                <input type="text"
                       name="searchTerm"
                       value="@ViewBag.SearchTerm"
                       class="form-control"
                       placeholder="Search by item name, category, or description..." />

                <button type="submit" class="btn btn-primary">Search</button>

                <a asp-controller="Manager" asp-action="AddMenuItem" class="btn btn-success">
                    Add Item
                </a>
            </form>
        </div>
    </div>

    <div class="card dashboard-card">
        <div class="card-header bg-white">
            <h5 class="mb-0">Menu Items</h5>
        </div>

        <div class="card-body">
            @if (Model.Count == 0)
            {
                <p class="text-muted mb-0">No menu items found.</p>
            }
            else
            {
                <div class="table-responsive manager-table-scroll">
                    <table class="table table-hover align-middle manager-wide-table manager-menu-items-table">
                        <thead class="table-light">
                            <tr>
                                <th>Image</th>
                                <th>Item</th>
                                <th>Category</th>
                                <th>Description</th>
                                <th>Price</th>
                                <th>Status</th>
                                <th>Created By</th>
                                <th>Actions</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(item.ImagePath))
                                        {
                                            <img src="@item.ImagePath"
                                                 alt="@item.ItemName"
                                                 class="menu-item-thumbnail" />
                                        }
                                        else
                                        {
                                            <span class="text-muted">No image</span>
                                        }
                                    </td>

                                    <td>@item.ItemName</td>
                                    <td>@item.CategoryName</td>
                                    <td>@item.Description</td>
                                    <td>@item.Price.ToString("C")</td>

                                    <td>
                                        @if (item.IsAvailable)
                                        {
                                            <span class="badge bg-success">Available</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Unavailable</span>
                                        }
                                    </td>

                                    <td>@item.CreatedByUsername</td>

                                    <td>
                                        <div class="manager-table-actions">
                                            <a asp-controller="Manager"
                                               asp-action="EditMenuItem"
                                               asp-route-id="@item.MenuItemID"
                                               class="btn btn-sm btn-outline-primary">
                                                Edit
                                            </a>

                                            @if (item.IsAvailable)
                                            {
                                                <form asp-controller="Manager"
                                                      asp-action="SetMenuItemAvailability"
                                                      asp-route-id="@item.MenuItemID"
                                                      asp-route-isAvailable="false"
                                                      method="post"
                                                      onsubmit="return confirm('Mark this item as unavailable?');">
                                                    <button type="submit" class="btn btn-sm btn-outline-warning">
                                                        Unavailable
                                                    </button>
                                                </form>
                                            }
                                            else
                                            {
                                                <form asp-controller="Manager"
                                                      asp-action="SetMenuItemAvailability"
                                                      asp-route-id="@item.MenuItemID"
                                                      asp-route-isAvailable="true"
                                                      method="post">
                                                    <button type="submit" class="btn btn-sm btn-outline-success">
                                                        Available
                                                    </button>
                                                </form>

                                                <form asp-controller="Manager"
                                                      asp-action="DeleteMenuItem"
                                                      asp-route-id="@item.MenuItemID"
                                                      method="post"
                                                      onsubmit="return confirm('Delete this menu item? Only unused items can be deleted.');">
                                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                                        Delete
                                                    </button>
                                                </form>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>