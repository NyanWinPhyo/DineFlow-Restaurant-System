@model List<DineFlowRestaurantSystem.ViewModels.ReviewListItemViewModel>

@{
    Layout = "~/Views/Shared/_ChefLayout.cshtml";
    ViewData["Title"] = "Customer Reviews";
}

<div class="chef-page-container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">Customer Reviews</h2>
            <p class="text-muted mb-0">Welcome, @ViewBag.Username. Read feedback from completed orders.</p>
        </div>

        <div class="d-flex gap-2">
            <a asp-controller="Chef" asp-action="Index" class="btn btn-outline-primary">
                Kitchen Dashboard
            </a>

            <a asp-controller="Auth" asp-action="Logout" class="btn btn-outline-danger">
                Logout
            </a>
        </div>
    </div>

    <div class="card chef-card chef-filter-card">
        <div class="card-body">
            <form asp-controller="Chef" asp-action="Reviews" method="get" class="row g-2">
                <div class="col-md-6">
                    <input type="text"
                           name="searchTerm"
                           value="@ViewBag.SearchTerm"
                           class="form-control"
                           placeholder="Search by order ID, customer, or comment..." />
                </div>

                <div class="col-md-3">
                    <select name="ratingFilter" class="form-select">
                        <option value="">All Ratings</option>
                        <option value="5" selected="@(ViewBag.RatingFilter == 5)">5 Stars</option>
                        <option value="4" selected="@(ViewBag.RatingFilter == 4)">4 Stars</option>
                        <option value="3" selected="@(ViewBag.RatingFilter == 3)">3 Stars</option>
                        <option value="2" selected="@(ViewBag.RatingFilter == 2)">2 Stars</option>
                        <option value="1" selected="@(ViewBag.RatingFilter == 1)">1 Star</option>
                    </select>
                </div>

                <div class="col-md-3">
                    <button type="submit" class="btn btn-primary w-100">
                        Filter
                    </button>
                </div>
            </form>
        </div>
    </div>

    @if (Model.Count == 0)
    {
        <div class="alert alert-info">
            No reviews found.
        </div>
    }
    else
    {
        <div class="row g-4 chef-review-grid">
            @foreach (var review in Model)
            {
                <div class="col-lg-6 col-xl-5">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div>
                                    <h5 class="mb-1">Order #@review.OrderID</h5>
                                    <div class="text-muted small">
                                        @review.CustomerName (@review.CustomerLoginID)
                                    </div>
                                </div>

                                <span class="badge bg-warning text-dark">
                                    @review.Rating / 5
                                </span>
                            </div>

                            <p class="mb-3">
                                @if (string.IsNullOrWhiteSpace(review.Comment))
                                {
                                    <span class="text-muted">No written comment.</span>
                                }
                                else
                                {
                                    @review.Comment
                                }
                            </p>

                            <div class="text-muted small">
                                Reviewed at: @review.CreatedAt.ToString("yyyy-MM-dd HH:mm")
                            </div>

                            <div class="text-muted small">
                                Order date: @review.OrderDate.ToString("yyyy-MM-dd HH:mm")
                            </div>

                            @if (!string.IsNullOrWhiteSpace(review.AdminResponse))
                            {
                                <hr />

                                <div>
                                    <strong>Management Response:</strong>
                                    <p class="mb-0">@review.AdminResponse</p>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>