@model List<DineFlowRestaurantSystem.ViewModels.IngredientListItemViewModel>

@{
    Layout = "~/Views/Shared/_ChefLayout.cshtml";
    ViewData["Title"] = "Ingredients";
}

<div class="chef-page-container">
    <div class="chef-page-header">
        <div>
            <h2 class="mb-1">Ingredients</h2>
            <p class="text-muted mb-0">View ingredient stock levels and low stock alerts.</p>
        </div>

        <div class="chef-action-bar">
            <a asp-controller="Chef" asp-action="StockTransactions" class="btn btn-outline-secondary">
                Stock Transactions
            </a>
        </div>
    </div>

    <div class="card chef-card chef-filter-card">
        <div class="card-body">
            <form asp-controller="Chef" asp-action="Ingredients" method="get" class="row g-2">
                <div class="col-md-10">
                    <input type="text"
                           name="searchTerm"
                           value="@ViewBag.SearchTerm"
                           class="form-control"
                           placeholder="Search by ingredient name or unit..." />
                </div>

                <div class="col-md-2 d-grid">
                    <button type="submit" class="btn btn-outline-primary">Search</button>
                </div>
            </form>
        </div>
    </div>

    <div class="card chef-card">
        <div class="card-body">
            @if (Model.Count == 0)
            {
                <div class="alert alert-info mb-0">No ingredients found.</div>
            }
            else
            {
                <div class="table-responsive chef-table-scroll">
                    <table class="table table-hover align-middle chef-ingredients-table">
                        <colgroup>
                            <col class="chef-ingredient-id-col" />
                            <col class="chef-ingredient-name-col" />
                            <col class="chef-ingredient-unit-col" />
                            <col class="chef-ingredient-stock-col" />
                            <col class="chef-ingredient-reorder-col" />
                            <col class="chef-ingredient-status-col" />
                            <col class="chef-ingredient-alert-col" />
                        </colgroup>

                        <thead class="table-light">
                            <tr>
                                <th>ID</th>
                                <th>Ingredient</th>
                                <th>Unit</th>
                                <th>Current Stock</th>
                                <th>Reorder Level</th>
                                <th>Status</th>
                                <th>Stock Alert</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var ingredient in Model)
                            {
                                <tr>
                                    <td>@ingredient.IngredientID</td>
                                    <td>@ingredient.IngredientName</td>
                                    <td>@ingredient.Unit</td>
                                    <td>@ingredient.CurrentStock.ToString("N2") @ingredient.Unit</td>
                                    <td>@ingredient.ReorderLevel.ToString("N2") @ingredient.Unit</td>
                                    <td>
                                        @if (ingredient.IsActive)
                                        {
                                            <span class="badge bg-success">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Inactive</span>
                                        }
                                    </td>
                                    <td>
                                        @if (ingredient.IsLowStock)
                                        {
                                            <span class="badge bg-warning text-dark">Low Stock</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">OK</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>