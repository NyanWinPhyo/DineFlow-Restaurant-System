@model DineFlowRestaurantSystem.ViewModels.MenuItemFormViewModel

@{
    ViewData["Title"] = "Edit Menu Item";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">Edit Menu Item</h2>
            <p class="text-muted mb-0">Update menu item details, image, and availability.</p>
        </div>

        <a asp-controller="Chef" asp-action="MenuItems" class="btn btn-outline-primary">
            Back to Menu Items
        </a>
    </div>

    <div class="card">
        <div class="card-body">
            <form asp-controller="Chef"
                  asp-action="EditMenuItem"
                  method="post"
                  enctype="multipart/form-data"
                  onsubmit="disableSubmitButton(this)">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <input type="hidden" asp-for="MenuItemID" />
                <input type="hidden" asp-for="ExistingImagePath" />

                <div class="mb-3">
                    <label asp-for="ItemName" class="form-label"></label>
                    <input asp-for="ItemName" class="form-control" />
                    <span asp-validation-for="ItemName" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="CategoryID" class="form-label"></label>
                    <select asp-for="CategoryID" class="form-select">
                        <option value="0">-- Select Category --</option>

                        @foreach (var category in Model.Categories)
                        {
                            <option value="@category.CategoryID">
                                @category.CategoryName
                            </option>
                        }
                    </select>
                    <span asp-validation-for="CategoryID" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Price" class="form-label"></label>
                    <input asp-for="Price" class="form-control" readonly />
                    <div class="form-text">
                        Price can only be changed by Admin or Manager.
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="ImageFile" class="form-label">Food Image</label>

                    @if (!string.IsNullOrWhiteSpace(Model.ExistingImagePath))
                    {
                        <div class="mb-2">
                            <img src="@Model.ExistingImagePath"
                                 alt="@Model.ItemName"
                                 class="menu-item-preview" />
                        </div>

                        <div class="form-check mb-2">
                            <input asp-for="RemoveImage" class="form-check-input" />
                            <label asp-for="RemoveImage" class="form-check-label">
                                Remove current image
                            </label>
                        </div>
                    }

                    <input asp-for="ImageFile"
                           type="file"
                           class="form-control"
                           accept=".jpg,.jpeg,.png,.webp" />

                    <span asp-validation-for="ImageFile" class="text-danger"></span>
                    <div class="form-text">Upload a new image to replace the current one.</div>
                </div>

                <div class="form-check mb-3">
                    <input asp-for="IsAvailable" class="form-check-input" />
                    <label asp-for="IsAvailable" class="form-check-label"></label>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        Save Changes
                    </button>

                    <a asp-controller="Chef" asp-action="MenuItems" class="btn btn-secondary">
                        Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        function disableSubmitButton(form) {
            if (!form.checkValidity()) {
                return;
            }

            const button = form.querySelector("button[type='submit']");

            if (button) {
                button.disabled = true;
                button.innerText = "Saving...";
            }
        }
    </script>
}