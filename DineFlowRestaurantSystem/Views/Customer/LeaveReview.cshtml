@model DineFlowRestaurantSystem.ViewModels.ReviewFormViewModel

@{
    ViewData["Title"] = "Leave Review";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">Leave Review</h2>
            <p class="text-muted mb-0">Share your experience for Order #@Model.OrderID.</p>
        </div>

        <div class="d-flex gap-2">
            <span class="btn btn-outline-success disabled">
                Wallet: @(((decimal)ViewBag.WalletBalance).ToString("C"))
            </span>

            <a asp-controller="Customer" asp-action="Orders" class="btn btn-outline-primary">
                Back to Orders
            </a>

            <a asp-controller="Auth" asp-action="Logout" class="btn btn-outline-danger">
                Logout
            </a>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <form asp-action="LeaveReview" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <input type="hidden" asp-for="OrderID" />

                <div class="mb-3">
                    <label asp-for="Rating" class="form-label"></label>
                    <select asp-for="Rating" class="form-select">
                        <option value="5">5 - Excellent</option>
                        <option value="4">4 - Good</option>
                        <option value="3">3 - Average</option>
                        <option value="2">2 - Poor</option>
                        <option value="1">1 - Terrible</option>
                    </select>
                    <span asp-validation-for="Rating" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Comment" class="form-label"></label>
                    <textarea asp-for="Comment"
                              class="form-control"
                              rows="5"
                              placeholder="Write your review here..."></textarea>
                    <span asp-validation-for="Comment" class="text-danger"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        Submit Review
                    </button>

                    <a asp-controller="Customer" asp-action="Orders" class="btn btn-secondary">
                        Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}