@model List<DineFlowRestaurantSystem.ViewModels.CustomerOrderListItemViewModel>

@{
    ViewData["Title"] = "My Orders";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">My Orders</h2>
            <p class="text-muted mb-0">Track your order history, @ViewBag.Username.</p>
        </div>

        <div class="d-flex gap-2">
            <span class="btn btn-outline-success disabled">
                Wallet: @(((decimal)ViewBag.WalletBalance).ToString("C"))
            </span>

            <a asp-controller="Customer" asp-action="Menu" class="btn btn-outline-primary">
                Back to Menu
            </a>

            <a asp-controller="Auth" asp-action="Logout" class="btn btn-outline-danger">
                Logout
            </a>
        </div>
    </div>

    @if (Model.Count == 0)
    {
        <div class="alert alert-info">
            You have not placed any orders yet.
        </div>
    }
    else
    {
        <div class="card">
            <div class="card-body">
                <table class="table align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Order ID</th>
                            <th>Date</th>
                            <th>Total</th>
                            <th>Order Status</th>
                            <th>Payment</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var order in Model)
                        {
                            <tr>
                                <td>#@order.OrderID</td>
                                <td>@order.OrderDate.ToString("yyyy-MM-dd HH:mm")</td>
                                <td>@order.TotalAmount.ToString("C")</td>

                                <td>
                                    <span class="badge bg-primary">
                                        @order.OrderStatus
                                    </span>
                                </td>

                                <td>
                                    <span class="badge bg-success">
                                        @order.PaymentStatus
                                    </span>
                                </td>

                                <td>
                                    <a asp-controller="Customer"
                                       asp-action="OrderDetails"
                                       asp-route-id="@order.OrderID"
                                       class="btn btn-sm btn-outline-primary">
                                        View Details
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>