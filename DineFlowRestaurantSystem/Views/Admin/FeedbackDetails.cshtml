@model DineFlowRestaurantSystem.ViewModels.ReviewResponseViewModel

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Feedback Details";

    var review = ViewBag.Review as DineFlowRestaurantSystem.ViewModels.ReviewListItemViewModel;
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

<div class="card dashboard-card mb-4">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Feedback for Order #@review?.OrderID</h5>

        <a asp-controller="Admin" asp-action="Feedback" class="btn btn-secondary btn-sm">
            Back to Feedback
        </a>
    </div>

    <div class="card-body">
        <p><strong>Customer:</strong> @review?.CustomerName (@review?.CustomerLoginID)</p>
        <p><strong>Rating:</strong> <span class="badge bg-warning text-dark">@review?.Rating / 5</span></p>
        <p><strong>Order Status:</strong> @review?.OrderStatus</p>
        <p><strong>Submitted At:</strong> @review?.CreatedAt.ToString("yyyy-MM-dd HH:mm")</p>

        <hr />

        <h6>Customer Comment</h6>

        @if (string.IsNullOrWhiteSpace(review?.Comment))
        {
            <p class="text-muted">No written comment.</p>
        }
        else
        {
            <p>@review.Comment</p>
        }

        @if (!string.IsNullOrWhiteSpace(review?.RespondedByUsername))
        {
            <hr />
            <p class="text-muted mb-0">
                Last responded by @review.RespondedByUsername
                at @review.RespondedAt?.ToString("yyyy-MM-dd HH:mm")
            </p>
        }
    </div>
</div>

<div class="card dashboard-card">
    <div class="card-header bg-white">
        <h5 class="mb-0">Management Response</h5>
    </div>

    <div class="card-body">
        <form asp-action="FeedbackDetails" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <input type="hidden" asp-for="FeedbackID" />

            <div class="mb-3">
                <label asp-for="AdminResponse" class="form-label"></label>
                <textarea asp-for="AdminResponse"
                          class="form-control"
                          rows="5"
                          placeholder="Write a response to this customer feedback..."></textarea>
                <span asp-validation-for="AdminResponse" class="text-danger"></span>
            </div>

            <div class="form-check mb-3">
                <input asp-for="IsReviewed" class="form-check-input" />
                <label asp-for="IsReviewed" class="form-check-label"></label>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    Save Response
                </button>

                <a asp-controller="Admin" asp-action="Feedback" class="btn btn-secondary">
                    Cancel
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}