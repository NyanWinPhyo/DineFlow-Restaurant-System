@model DineFlowRestaurantSystem.ViewModels.UserFormViewModel

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Edit User";
}

<div class="card dashboard-card">
    <div class="card-header bg-white">
        <h5 class="mb-0">Edit User</h5>
    </div>

    <div class="card-body">
        <form asp-action="EditUser" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <input type="hidden" asp-for="UserID" />

            <div class="mb-3">
                <label asp-for="LoginID" class="form-label"></label>
                <input asp-for="LoginID" class="form-control" />
                <span asp-validation-for="LoginID" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Username" class="form-label"></label>
                <input asp-for="Username" class="form-control" />
                <span asp-validation-for="Username" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" class="form-control" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Role" class="form-label"></label>
                <select asp-for="Role" class="form-select" id="roleSelect">
                    <option value="">-- Select Role --</option>
                    <option value="Admin">Admin</option>
                    <option value="Manager">Manager</option>
                    <option value="Chef">Chef</option>
                    <option value="Customer">Customer</option>
                </select>
                <span asp-validation-for="Role" class="text-danger"></span>
            </div>

            <div class="mb-3" id="walletGroup">
                <label asp-for="WalletBalance" class="form-label"></label>
                <input asp-for="WalletBalance" class="form-control" />
                <span asp-validation-for="WalletBalance" class="text-danger"></span>
            </div>

            <div class="form-check mb-3">
                <input asp-for="IsActive" class="form-check-input" />
                <label asp-for="IsActive" class="form-check-label">
                    Active Account
                </label>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Save Changes</button>
                <a asp-action="Users" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        function toggleWalletField() {
            const role = document.getElementById("roleSelect").value;
            const walletGroup = document.getElementById("walletGroup");

            if (role === "Customer") {
                walletGroup.style.display = "block";
            } else {
                walletGroup.style.display = "none";
            }
        }

        document.getElementById("roleSelect").addEventListener("change", toggleWalletField);
        toggleWalletField();
    </script>
}