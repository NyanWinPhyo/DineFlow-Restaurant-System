@model DineFlowRestaurantSystem.ViewModels.AdminDashboardViewModel
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Admin Dashboard";
}

<div class="row g-4 mb-4">
    <div class="col-md-3">
        <div class="card dashboard-card">
            <div class="card-body">
                <h6 class="text-muted">Total Users</h6>
                <h2>@Model.TotalUsers</h2>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card dashboard-card">
            <div class="card-body">
                <h6 class="text-muted">Menu Items</h6>
                <h2>@Model.TotalMenuItems</h2>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card dashboard-card">
            <div class="card-body">
                <h6 class="text-muted">Available Items</h6>
                <h2>@Model.AvailableMenuItems</h2>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card dashboard-card">
            <div class="card-body">
                <h6 class="text-muted">Categories</h6>
                <h2>@Model.TotalCategories</h2>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="card dashboard-card">
            <div class="card-body">
                <h6 class="text-muted">Total Orders</h6>
                <h2>@Model.TotalOrders</h2>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card dashboard-card">
            <div class="card-body">
                <h6 class="text-muted">Total Sales</h6>
                <h2>@Model.TotalSales.ToString("C")</h2>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card dashboard-card">
            <div class="card-body">
                <h6 class="text-muted">Active Role</h6>
                <h2>@Model.ActiveRole</h2>
            </div>
        </div>
    </div>
</div>