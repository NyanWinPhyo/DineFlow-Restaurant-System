@model List<DineFlowRestaurantSystem.ViewModels.ReviewListItemViewModel>

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Feedback Management";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

<div class="card dashboard-card mb-4">
    <div class="card-body">
        <form asp-controller="Admin" asp-action="Feedback" method="get" class="row g-2">
            <div class="col-md-4">
                <input type="text"
                       name="searchTerm"
                       value="@ViewBag.SearchTerm"
                       class="form-control"
                       placeholder="Search by order ID, customer, or comment..." />
            </div>

            <div class="col-md-3">
                <select name="ratingFilter" class="form-select">
                    <option value="">All Ratings</option>
                    <option value="5" selected="@(ViewBag.RatingFilter == 5)">5 Stars</option>
                    <option value="4" selected="@(ViewBag.RatingFilter == 4)">4 Stars</option>
                    <option value="3" selected="@(ViewBag.RatingFilter == 3)">3 Stars</option>
                    <option value="2" selected="@(ViewBag.RatingFilter == 2)">2 Stars</option>
                    <option value="1" selected="@(ViewBag.RatingFilter == 1)">1 Star</option>
                </select>
            </div>

            <div class="col-md-3">
                <select name="reviewedFilter" class="form-select">
                    <option value="">All Review Statuses</option>
                    <option value="false" selected="@(ViewBag.ReviewedFilter == false)">Pending Review</option>
                    <option value="true" selected="@(ViewBag.ReviewedFilter == true)">Reviewed</option>
                </select>
            </div>

            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100">
                    Filter
                </button>
            </div>
        </form>
    </div>
</div>

<div class="card dashboard-card">
    <div class="card-header bg-white">
        <h5 class="mb-0">Customer Feedback</h5>
    </div>

    <div class="card-body">
        @if (Model.Count == 0)
        {
            <p class="text-muted mb-0">No feedback found.</p>
        }
        else
        {
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Order</th>
                        <th>Customer</th>
                        <th>Rating</th>
                        <th>Comment</th>
                        <th>Status</th>
                        <th>Created At</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var review in Model)
                    {
                        <tr>
                            <td>#@review.OrderID</td>

                            <td>
                                @review.CustomerName
                                <div class="text-muted small">@review.CustomerLoginID</div>
                            </td>

                            <td>
                                <span class="badge bg-warning text-dark">
                                    @review.Rating / 5
                                </span>
                            </td>

                            <td>
                                @if (string.IsNullOrWhiteSpace(review.Comment))
                                {
                                    <span class="text-muted">No comment</span>
                                }
                                else
                                {
                                    @review.Comment
                                }
                            </td>

                            <td>
                                @if (review.IsReviewed)
                                {
                                    <span class="badge bg-success">Reviewed</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Pending Review</span>
                                }
                            </td>

                            <td>@review.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>

                            <td>
                                <a asp-controller="Admin"
                                   asp-action="FeedbackDetails"
                                   asp-route-id="@review.FeedbackID"
                                   class="btn btn-sm btn-outline-primary">
                                    View / Respond
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>