@model DineFlowRestaurantSystem.ViewModels.RestockIngredientViewModel

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Restock Ingredient";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-1">Restock Ingredient</h2>
        <p class="text-muted mb-0">Increase ingredient stock and record the transaction.</p>
    </div>

    <a asp-controller="Admin" asp-action="Ingredients" class="btn btn-outline-secondary">
        Back to Ingredients
    </a>
</div>

<div class="card dashboard-card">
    <div class="card-body">
        <form asp-controller="Admin" asp-action="RestockIngredient" method="post">
            <input asp-for="IngredientID" type="hidden" />
            <input asp-for="IngredientName" type="hidden" />
            <input asp-for="Unit" type="hidden" />
            <input asp-for="CurrentStock" type="hidden" />

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label class="form-label">Ingredient</label>
                <input value="@Model.IngredientName" class="form-control" readonly />
            </div>

            <div class="mb-3">
                <label class="form-label">Current Stock</label>
                <input value="@Model.CurrentStock.ToString("N2") @Model.Unit" class="form-control" readonly />
            </div>

            <div class="mb-3">
                <label asp-for="Quantity" class="form-label"></label>
                <div class="input-group">
                    <input asp-for="Quantity" class="form-control" type="number" step="0.01" min="0.01" />
                    <span class="input-group-text">@Model.Unit</span>
                </div>
                <span asp-validation-for="Quantity" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="UnitCost" class="form-label"></label>
                <input asp-for="UnitCost" class="form-control" type="number" step="0.0001" min="0" />
                <span asp-validation-for="UnitCost" class="text-danger"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Reason" class="form-label"></label>
                <textarea asp-for="Reason" class="form-control" rows="3" placeholder="Example: Supplier restock, weekly stock update..."></textarea>
                <span asp-validation-for="Reason" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-success">Restock</button>
            <a asp-controller="Admin" asp-action="Ingredients" class="btn btn-outline-secondary">Cancel</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}