@model List<DineFlowRestaurantSystem.ViewModels.UserListItemViewModel>

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "User Management";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

<div class="card dashboard-card mb-4">
    <div class="card-body">
        <form asp-controller="Admin" asp-action="Users" method="get" class="row g-2">
            <div class="col-md-10">
                <input type="text"
                       name="searchTerm"
                       value="@ViewBag.SearchTerm"
                       class="form-control"
                       placeholder="Search by login ID, username, or role..." />
            </div>

            <div class="col-md-2 d-grid">
                <button type="submit" class="btn btn-primary">
                    Search
                </button>
            </div>
        </form>
    </div>
</div>

<div class="card dashboard-card">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <h5 class="mb-0">User List</h5>

        <a asp-controller="Admin" asp-action="AddUser" class="btn btn-primary btn-sm">
            Add User
        </a>
    </div>

    <div class="card-body">
        @if (Model.Count == 0)
        {
            <div class="alert alert-warning mb-0">
                No users found.
            </div>
        }
        else
        {
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>User ID</th>
                        <th>Login ID</th>
                        <th>Username</th>
                        <th>Role</th>
                        <th>Wallet Balance</th>
                        <th>Status</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var user in Model)
                    {
                        <tr>
                            <td>@user.UserID</td>
                            <td>@user.LoginID</td>
                            <td>@user.Username</td>
                            <td>@user.Role</td>

                            <td>
                                @if (user.WalletBalance.HasValue)
                                {
                                    @user.WalletBalance.Value.ToString("C")
                                }
                                else
                                {
                                    <span class="text-muted">N/A</span>
                                }
                            </td>

                            <td>
                                @if (user.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inactive</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>