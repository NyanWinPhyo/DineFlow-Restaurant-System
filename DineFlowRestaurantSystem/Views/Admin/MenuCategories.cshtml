    @model List<DineFlowRestaurantSystem.ViewModels.MenuCategoryListItemViewModel>

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Menu Categories";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

<div class="card dashboard-card mb-4">
    <div class="card-body">
        <form asp-controller="Admin" asp-action="MenuCategories" method="get" class="d-flex gap-2">
            <input type="text"
                   name="searchTerm"
                   value="@ViewBag.SearchTerm"
                   class="form-control"
                   placeholder="Search categories..." />

            <button type="submit" class="btn btn-primary">
                Search
            </button>
        </form>
    </div>
</div>

<div class="card dashboard-card">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Menu Category List</h5>

        <a asp-controller="Admin" asp-action="AddMenuCategory" class="btn btn-primary btn-sm">
            Add Category
        </a>
    </div>

    <div class="card-body">
        @if (Model.Count == 0)
        {
            <p class="text-muted mb-0">No categories found.</p>
        }
        else
        {
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>ID</th>
                        <th>Category Name</th>
                        <th>Status</th>
                        <th>Created At</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var category in Model)
                    {
                        <tr>
                            <td>@category.CategoryID</td>
                            <td>@category.CategoryName</td>

                            <td>
                                @if (category.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inactive</span>
                                }
                            </td>

                            <td>@category.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>

                            <td>
                                <div class="d-flex gap-2">
                                    <a asp-controller="Admin"
                                       asp-action="EditMenuCategory"
                                       asp-route-id="@category.CategoryID"
                                       class="btn btn-sm btn-outline-primary">
                                        Edit
                                    </a>

                                    @if (category.IsActive)
                                    {
                                        <form asp-controller="Admin"
                                              asp-action="SetMenuCategoryStatus"
                                              asp-route-id="@category.CategoryID"
                                              asp-route-isActive="false"
                                              method="post"
                                              onsubmit="return confirm('Deactivate this category?');">
                                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                                Deactivate
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form asp-controller="Admin"
                                              asp-action="SetMenuCategoryStatus"
                                              asp-route-id="@category.CategoryID"
                                              asp-route-isActive="true"
                                              method="post">
                                            <button type="submit" class="btn btn-sm btn-outline-success">
                                                Activate
                                            </button>
                                        </form>

                                        <form asp-controller="Admin"
                                              asp-action="DeleteMenuCategory"
                                              asp-route-id="@category.CategoryID"
                                              method="post"
                                              onsubmit="return confirm('This will permanently delete the category. Continue?');">
                                            <button type="submit" class="btn btn-sm btn-outline-dark">
                                                Delete
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>