@model List<DineFlowRestaurantSystem.ViewModels.MenuItemListItemViewModel>

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Menu Management";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

<div class="card dashboard-card mb-4">
    <div class="card-body">
        <form asp-controller="Admin" asp-action="MenuItems" method="get" class="d-flex gap-2">
            <input type="text"
                   name="searchTerm"
                   value="@ViewBag.SearchTerm"
                   class="form-control"
                   placeholder="Search by item name, category, or description..." />

            <button type="submit" class="btn btn-primary">
                Search
            </button>
        </form>
    </div>
</div>

<div class="card dashboard-card">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Menu Item List</h5>

        <a asp-controller="Admin" asp-action="AddMenuItem" class="btn btn-primary btn-sm">
            Add Menu Item
        </a>
    </div>

    <div class="card-body">
        @if (Model.Count == 0)
        {
            <p class="text-muted mb-0">No menu items found.</p>
        }
        else
        {
            <div class="table-responsive admin-table-scroll">
                <table class="table table-hover align-middle admin-wide-table admin-menu-items-table">
                    <colgroup>
                        <col class="admin-menu-no-col" />
                        <col class="admin-menu-id-col" />
                        <col class="admin-menu-image-col" />
                        <col class="admin-menu-name-col" />
                        <col class="admin-menu-category-col" />
                        <col class="admin-menu-description-col" />
                        <col class="admin-menu-price-col" />
                        <col class="admin-menu-availability-col" />
                        <col class="admin-menu-created-col" />
                        <col class="admin-menu-actions-col" />
                    </colgroup>

                    <tbody>
                        @{
                            int rowNumber = 1;
                        }

                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@rowNumber</td>
                                <td>@item.MenuItemID</td>

                                <td>
                                    @if (!string.IsNullOrWhiteSpace(item.ImagePath))
                                    {
                                        <img src="@item.ImagePath"
                                             alt="@item.ItemName"
                                             class="menu-item-thumbnail" />
                                    }
                                    else
                                    {
                                        <span class="text-muted">No image</span>
                                    }
                                </td>

                                <td>@item.ItemName</td>
                                <td>@item.CategoryName</td>
                                <td>@item.Description</td>
                                <td>@item.Price.ToString("C")</td>

                                <td>
                                    @if (item.IsAvailable)
                                    {
                                        <span class="badge bg-success">Available</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Unavailable</span>
                                    }
                                </td>

                                <td>@item.CreatedByUsername</td>
                            
                                <td>
                                    <div class="admin-menu-item-actions">
                                        <a asp-controller="Admin"
                                           asp-action="EditMenuItem"
                                           asp-route-id="@item.MenuItemID"
                                           class="btn btn-sm btn-outline-primary">
                                            Edit
                                        </a>

                                        <a asp-controller="Admin"
                                           asp-action="MenuItemRecipe"
                                           asp-route-id="@item.MenuItemID"
                                           class="btn btn-sm btn-outline-secondary">
                                            Recipe
                                        </a>

                                        @if (item.IsAvailable)
                                        {
                                            <form asp-controller="Admin"
                                                  asp-action="SetMenuItemAvailability"
                                                  asp-route-id="@item.MenuItemID"
                                                  asp-route-isAvailable="false"
                                                  method="post">
                                                <button type="submit" class="btn btn-sm btn-outline-warning admin-menu-availability-btn">
                                                    Mark Unavailable
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <form asp-controller="Admin"
                                                  asp-action="SetMenuItemAvailability"
                                                  asp-route-id="@item.MenuItemID"
                                                  asp-route-isAvailable="true"
                                                  method="post">
                                                <button type="submit" class="btn btn-sm btn-outline-success admin-menu-availability-btn">
                                                    Mark Available
                                                </button>
                                            </form>
                                        }

                                        <form asp-controller="Admin"
                                              asp-action="DeleteMenuItem"
                                              asp-route-id="@item.MenuItemID"
                                              method="post"
                                              onsubmit="return confirm('Permanently delete this menu item?');">
                                            <button type="submit" class="btn btn-sm btn-outline-dark">
                                                Delete
                                            </button>
                                        </form>
                                    </div>
                                </td>
                                @{
                                    rowNumber++;
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>