@model List<DineFlowRestaurantSystem.ViewModels.StockTransactionListItemViewModel>

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Stock Transactions";
}

<div class="admin-page-header">
    <p class="text-muted mb-0">View recent ingredient stock movements.</p>

    <div class="admin-page-actions">
        <a asp-controller="Admin" asp-action="Ingredients" class="btn btn-outline-secondary">
            Back to Ingredients
        </a>
    </div>
</div>

<div class="card dashboard-card">
    <div class="card-body">
        @if (Model.Count == 0)
        {
            <div class="alert alert-info mb-0">No stock transactions found.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>ID</th>
                            <th>Date</th>
                            <th>Ingredient</th>
                            <th>Type</th>
                            <th>Quantity Change</th>
                            <th>Unit Cost</th>
                            <th>Total Cost</th>
                            <th>Reason</th>
                            <th>Created By</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var transaction in Model)
                        {
                            <tr>
                                <td>@transaction.StockTransactionID</td>
                                <td>@transaction.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                                <td>@transaction.IngredientName</td>
                                <td>
                                    @if (transaction.TransactionType == "Restock")
                                    {
                                        <span class="badge bg-success">Restock</span>
                                    }
                                    else if (transaction.TransactionType == "Usage")
                                    {
                                        <span class="badge bg-primary">Usage</span>
                                    }
                                    else if (transaction.TransactionType == "Waste")
                                    {
                                        <span class="badge bg-danger">Waste</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">@transaction.TransactionType</span>
                                    }
                                </td>
                                <td>@transaction.QuantityChange.ToString("N2") @transaction.Unit</td>
                                <td>@(transaction.UnitCost?.ToString("C4") ?? "-")</td>
                                <td>@(transaction.TotalCost?.ToString("C2") ?? "-")</td>
                                <td>@(transaction.Reason ?? "-")</td>
                                <td>@(transaction.CreatedByUsername ?? "-")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>