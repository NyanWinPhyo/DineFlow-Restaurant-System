@{
    string? currentAction = ViewContext.RouteData.Values["action"]?.ToString();

    string IsActive(params string[] actions)
    {
        return Array.IndexOf(actions, currentAction) >= 0
            ? "active-admin-link"
            : "";
    }
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DineFlow Admin</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body>
    <div class="d-flex min-vh-100">
        <aside class="admin-sidebar bg-dark text-white p-3">
            <h3 class="mb-4">DineFlow</h3>

            <ul class="nav flex-column">
                <li class="nav-item mb-2">
                    <a asp-controller="Admin"
                       asp-action="Index"
                       class="nav-link text-white @IsActive("Index")">
                        Dashboard
                    </a>
                </li>

                <li class="nav-item mb-2">
                    <a asp-controller="Admin"
                       asp-action="Users"
                       class="nav-link text-white @IsActive("Users", "AddUser", "EditUser")">
                        Users
                    </a>
                </li>

                <li class="nav-item mb-2">
                    <a asp-controller="Admin"
                       asp-action="Orders"
                       class="nav-link text-white @IsActive("Orders", "OrderDetails")">
                        Orders
                    </a>
                </li>

                <li class="nav-item mb-2">
                    <a asp-controller="Admin"
                       asp-action="Feedback"
                       class="nav-link text-white @IsActive("Feedback", "FeedbackDetails")">
                        Feedback
                    </a>
                </li>

                <li class="nav-item mb-2">
                    <a asp-controller="Admin"
                       asp-action="MenuItems"
                       class="nav-link text-white @IsActive("MenuItems", "AddMenuItem", "EditMenuItem")">
                        Menu Items
                    </a>
                </li>

                <li class="nav-item mb-2">
                    <a asp-controller="Admin"
                       asp-action="MenuCategories"
                       class="nav-link text-white @IsActive("MenuCategories", "AddMenuCategory", "EditMenuCategory")">
                        Menu Categories
                    </a>
                </li>

                <li class="nav-item mb-2">
                    <a asp-controller="Admin"
                       asp-action="SalesReport"
                       class="nav-link text-white @IsActive("SalesReport")">
                        Sales Report
                    </a>
                </li>

                <li class="nav-item mb-2">
                    <a asp-controller="Admin"
                       asp-action="Profile"
                       class="nav-link text-white @IsActive("Profile")">
                        Profile
                    </a>
                </li>
            </ul>
        </aside>

        <main class="flex-grow-1 bg-light">
            <nav class="navbar navbar-light bg-white border-bottom px-4">
                <span class="navbar-brand mb-0 h1">@ViewData["Title"]</span>

                <div>
                    <span class="me-3">Welcome, @ViewBag.Username</span>
                    <a asp-controller="Auth" asp-action="Logout" class="btn btn-outline-danger btn-sm">
                        Logout
                    </a>
                </div>
            </nav>

            <div class="container-fluid p-4">
                @RenderBody()
            </div>
        </main>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>